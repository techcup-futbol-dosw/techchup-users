              "path": ["api", "users"]
            },
            "description": "PLAYER no tiene permiso. Debe retornar 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "18 - Actualizar usuario (solo ADMIN) → 403",
          "request": {
            "method": "PUT",
