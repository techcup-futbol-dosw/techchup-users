          "name": "16 - Buscar jugadores (solo CAPTAIN/ADMIN) → 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?name=carlos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [{ "key": "name", "value": "carlos" }]
            },
            "description": "PLAYER no tiene permiso. Debe retornar 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "17 - Listar todos los usuarios (solo ADMIN) → 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
