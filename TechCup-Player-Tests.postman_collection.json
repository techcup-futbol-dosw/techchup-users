  "item": [
    {
      "name": "Users - Perfil propio",
      "item": [
        {
          "name": "01 - Obtener mi perfil (GET /api/users/{id})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "description": "PLAYER puede leer su propio perfil. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "02 - Actualizar mi perfil (PUT /api/users/me)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Edwin Suarez\",\n  \"identification\": \"1234567890\",\n  \"birthDate\": \"2000-05-15\",\n  \"gender\": \"MALE\",\n  \"schoolRelation\": \"STUDENT\",\n  \"academicProgram\": \"Ingenieria de Sistemas\",\n  \"semester\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "PLAYER actualiza su propio perfil. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "03 - Actualizar perfil con datos inválidos (PUT /api/users/me)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Body vacío debe retornar 400 Bad Request."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sport Profile - Perfil deportivo",
      "item": [
        {
          "name": "04 - Crear perfil deportivo (POST /api/sport-profiles/user/{userId})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('sportProfileId', json.id);",
                  "    console.log('sportProfileId guardado:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile",
                  "value": "{\"position\": \"MIDFIELDER\", \"dorsalNumber\": 10, \"available\": true}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "user", "{{userId}}"]
            },
            "description": "Crea un perfil deportivo. Guarda el ID en sportProfileId. Espera 201 Created."
          },
          "response": []
        },
        {
          "name": "05 - Crear perfil deportivo duplicado (debe dar 409)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile",
                  "value": "{\"position\": \"FORWARD\", \"dorsalNumber\": 9, \"available\": true}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "user", "{{userId}}"]
            },
            "description": "Crear un segundo perfil para el mismo usuario debe retornar 409 Conflict."
          },
          "response": []
        },
        {
          "name": "06 - Obtener mi perfil deportivo (GET /api/sport-profiles/user/{userId})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "user", "{{userId}}"]
            },
            "description": "Obtiene el perfil deportivo por userId. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "07 - Obtener perfil deportivo por ID (GET /api/sport-profiles/{id})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/{{sportProfileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "{{sportProfileId}}"]
            },
            "description": "Obtiene el perfil deportivo por su propio ID. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "08 - Actualizar perfil deportivo (PUT /api/sport-profiles/{id})",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile",
                  "value": "{\"position\": \"DEFENDER\", \"dorsalNumber\": 5, \"available\": false}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/{{sportProfileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "{{sportProfileId}}"]
            },
            "description": "Actualiza posición y dorsal del perfil deportivo. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "09 - Cambiar disponibilidad a true (PATCH /api/sport-profiles/{id}/availability)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/{{sportProfileId}}/availability?available=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "{{sportProfileId}}", "availability"],
              "query": [
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            },
            "description": "Marca el jugador como disponible. Espera 204 No Content."
          },
          "response": []
        },
        {
          "name": "10 - Cambiar disponibilidad a false (PATCH /api/sport-profiles/{id}/availability)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sport-profiles/{{sportProfileId}}/availability?available=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sport-profiles", "{{sportProfileId}}", "availability"],
              "query": [
                {
                  "key": "available",
                  "value": "false"
                }
              ]
            },
            "description": "Marca el jugador como no disponible. Espera 204 No Content."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invitations - Invitaciones recibidas",
      "item": [
        {
          "name": "11 - Listar mis invitaciones (GET /api/invitations/user/{userId})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "user", "{{userId}}"]
            },
            "description": "Lista todas las invitaciones recibidas por el jugador. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "12 - Obtener invitación por ID (GET /api/invitations/{id})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/{{invitationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "{{invitationId}}"]
            },
            "description": "Obtiene el detalle de una invitación específica. Llenar invitationId manualmente. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "13 - Aceptar invitación (PATCH /api/invitations/{id}/accept)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/{{invitationId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "{{invitationId}}", "accept"]
            },
            "description": "Acepta una invitación pendiente. Espera 200 OK."
          },
          "response": []
        },
        {
          "name": "14 - Aceptar invitación ya aceptada (debe dar 409)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/{{invitationId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "{{invitationId}}", "accept"]
            },
            "description": "Intentar aceptar una invitación ya aceptada debe retornar 409 Conflict."
          },
          "response": []
        },
        {
          "name": "15 - Rechazar invitación (PATCH /api/invitations/{id}/reject)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/{{invitationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "{{invitationId}}", "reject"]
            },
            "description": "Rechaza una invitación pendiente. Espera 200 OK."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Acceso denegado - PLAYER no puede (403)",
      "item": [
