        {
          "name": "20 - Enviar invitación (solo CAPTAIN) → 403",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/user/1/team/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "user", "1", "team", "1"]
            },
            "description": "PLAYER no puede enviar invitaciones, solo el CAPTAIN. Debe retornar 403 Forbidden."
          },
          "response": []
