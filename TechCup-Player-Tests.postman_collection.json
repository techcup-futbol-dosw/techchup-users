    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "21 - Inactivar mi cuenta (PATCH /api/users/{id}/inactivate)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/inactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}", "inactivate"]
            },
            "description": "El jugador inactiva su propia cuenta. Espera 204 No Content. EJECUTAR AL FINAL."
          },
          "response": []
