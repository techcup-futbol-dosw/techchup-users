# Copia este archivo como .env y rellena los valores antes de correr docker compose
# cp .env.example .env

# ── Base de datos PostgreSQL ───────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=cambia_esta_password

# ── MongoDB (fotos de jugadores) ───────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=cambia_esta_password

# ── Seguridad JWT ──────────────────────────────────────────────────────────
# Debe ser un string codificado en Base64 que represente al menos 256 bits (32 bytes).
# Debe ser el MISMO secreto que usa el identity-service.
# Para generar uno válido en PowerShell:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# En bash/Linux:
#   openssl rand -base64 32
JWT_SECRET=reemplaza-con-un-base64-de-32-bytes-generado-con-el-comando-de-arriba

# ── DDL de base de datos ───────────────────────────────────────────────────
# Primera ejecución (crea las tablas): DDL_AUTO=update
# Ejecuciones posteriores (solo valida el esquema): DDL_AUTO=validate
DDL_AUTO=update

# ── Servicios externos ─────────────────────────────────────────────────────
# URL del identity-service. Opciones:
#   - Servicio en Azure (mientras no esté dockerizado): https://tu-identity-service.azurewebsites.net
#   - Servicio local dockerizado (cuando el equipo lo dockerice): http://identity-service:8081
IDENTITY_SERVICE_URL=https://tu-identity-service.azurewebsites.net
